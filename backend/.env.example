# Configuracion de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_dashboard
DB_USER=
DB_PASSWORD=

# Configuracion de autenticacion JWT
# Generar una clave secreta aleatoria de al menos 64 caracteres
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Origenes del frontend permitidos, separados por comas
# Valores predeterminados para desarrollo local con Vite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173